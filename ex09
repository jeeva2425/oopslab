class Student {
    int id;
    String name;
    String department;
    int marks;

    // Constructor
    Student(int id, String name, String department, int marks) {
        this.id = id;
        this.name = name;
        this.department = department;
        this.marks = marks;
    }

    // Method to display student details
    void display() {
        System.out.println("Student ID: " + id);
        System.out.println("Name: " + name);
        System.out.println("Department: " + department);
        System.out.println("Marks: " + marks);
        System.out.println("--------------------");
    }

    public static void main(String[] args) {
        Student s1 = new Student(101, "Arun", "AI&DS", 90);
        Student s2 = new Student(102, "Priya", "CSE", 85);

        System.out.println("SMART COLLEGE MANAGEMENT SYSTEM");
        System.out.println("================================");

        s1.display();
        s2.display();
    }
}
